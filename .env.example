# Copy to .env and adjust. Never commit .env.
POSTGRES_DB=tradeguard
POSTGRES_USER=tradeguard
POSTGRES_PASSWORD=change-me-locally

# Host ports
DB_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Import the bundled SYNTHETIC sample CSV on first start (only when no batches exist).
TRADEGUARD_DEMO_LOAD=true
